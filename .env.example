# Django
SECRET_KEY=django-insecure-development-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web-skyvault

# Database (PostgreSQL — required for pgvector AI features)
DB_ENGINE=postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DJANGO_ENV=development

# AI Features — API keys
# Generation is routed through an Anthropic-compatible gateway (e.g. AgentRouter).
# Leave ANTHROPIC_BASE_URL empty to talk to api.anthropic.com directly.

# Primary generation (Anthropic-compatible /v1/messages)
ANTHROPIC_AUTH_TOKEN=your-anthropic-auth-token-here
ANTHROPIC_BASE_URL=https://agentrouter.org
ANTHROPIC_MODEL=claude-opus-5

# Fallback generation — optional. Same API shape; leave AI_FALLBACK_MODEL empty
# to disable. Key/base-url default to the primary values if unset.
AI_FALLBACK_MODEL=gpt-5.6-sol
AI_FALLBACK_API_KEY=your-fallback-auth-token-here
AI_FALLBACK_BASE_URL=https://agentrouter.org

# Embeddings (pgvector semantic search) — requires a REAL OpenAI key.
# AgentRouter does not serve /v1/embeddings. Leave OPENAI_BASE_URL empty for api.openai.com.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=

# AI Features — optional overrides
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
